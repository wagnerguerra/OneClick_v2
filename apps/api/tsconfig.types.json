{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "outDir": "./dist-types",
    "skipLibCheck": true,
    "incremental": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "dist-types", "test", "**/*.spec.ts", "**/*.test.ts"]
}
