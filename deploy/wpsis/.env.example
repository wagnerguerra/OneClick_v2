# OneClick — .env da segunda instalação (cliente wpsis)
# Destino na VPS: /opt/oneclick-wpsis/.env   (chmod 600, dono root)
#
# NUNCA comitar o arquivo preenchido. Este modelo tem só os NOMES.
#
# Como ler as marcações:
#   [NOVO]    valor exclusivo desta instalação. Copiar da outra é vazamento
#             (mesmo banco, mesmo bucket, mesma caixa de e-mail) ou quebra
#             (sessão, webhook).
#   [COPIAR]  pode vir igual da instalação atual — é credencial de serviço
#             externo compartilhado ou parâmetro técnico sem dado de cliente.
#   [DECIDIR] depende de o cliente usar a integração. Em dúvida, deixe vazio:
#             o módulo se desliga sozinho quando falta a chave.
#
# As chaves seguem a MESMA ordem do .env de produção, para conferência lado a
# lado (`diff <(grep -oE '^[A-Z_0-9]+=' a) <(grep -oE '^[A-Z_0-9]+=' b)`).

# ── Identidade da instalação ────────────────────────────────────────────────
NODE_ENV=production

# [NOVO] Banco PRÓPRIO no mesmo servidor Postgres. Reaproveitar `oneclick`
# misturaria os dois clientes na mesma base — o oposto do que esta instalação é.
DATABASE_URL=postgresql://USUARIO:SENHA@n8n-postgres-1:5432/oneclick_wpsis?schema=public

# [NOVO] Aponta para o redis DESTA stack (nome de container do compose).
REDIS_URL=redis://oneclick-wpsis-redis:6379

# [NOVO] Todos derivam do domínio. BETTER_AUTH_SECRET tem de ser gerado do
# zero (`openssl rand -base64 32`): repetir o da outra instalação faria um
# cookie de sessão de lá ser aceito aqui.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://oneclick.wpsis.com.br
NEXT_PUBLIC_APP_URL=https://oneclick.wpsis.com.br
NEXT_PUBLIC_API_URL=https://oneclick.wpsis.com.br
API_URL=https://oneclick.wpsis.com.br
TRUSTED_ORIGINS=https://oneclick.wpsis.com.br

# ── Autenticação social ─────────────────────────────────────────────────────
# [DECIDIR] Reaproveitar o app do Google exige ADICIONAR a nova redirect URI no
# console; sem isso o login falha com redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cobrança ────────────────────────────────────────────────────────────────
# [NOVO] O webhook do Stripe é por endpoint: crie um novo apontando para
# https://oneclick.wpsis.com.br/api/stripe/webhook e use o secret DELE aqui.
# Repetir o secret da outra instalação faz a verificação de assinatura falhar.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Armazenamento ───────────────────────────────────────────────────────────
# [NOVO] Bucket próprio. Compartilhar bucket é compartilhar documento e
# certificado digital de cliente.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── E-mail ──────────────────────────────────────────────────────────────────
# [NOVO] O domínio remetente precisa estar verificado no Resend. SMTP_FROM com
# domínio não verificado = e-mail rejeitado silenciosamente.
RESEND_API_KEY=
RESEND_INBOUND_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
SMTP_FROM=

# ── Legado / bases externas ─────────────────────────────────────────────────
# [DECIDIR] Só preencher se este cliente tiver o legado correspondente. Apontar
# para o legado do outro cliente importaria a carteira errada.
LEGACY_DB_HOST=
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
LEGACY_DB_NAME=
LEGACY_DB_PORT=
LEGACY_UPLOADS_BASE=
OCK_V1_DB_HOST=
OCK_V1_DB_PORT=
OCK_V1_DB_USER=
OCK_V1_DB_PASSWORD=
OCK_V1_DB_NAME=

# ── ERP SCI (Firebird) ──────────────────────────────────────────────────────
# [DECIDIR] O SCI fica na LAN do escritório; a VPS só o alcança pela ponte do
# Service Manager. Se este cliente não tem SCI, deixe tudo vazio — a gestão de
# contratos funciona sem, apenas sem os indicadores do ERP.
SCI_DSN=
SCI_USER=
SCI_PASSWORD=
SCI_CHARSET=UTF8
SCI_TIMEOUT_MS=30000
SCI_FATURAMENTO_TIMEOUT_CHUNK_MS=30000
SCI_FATURAMENTO_FORCE_BALANCETE=1
# [COPIAR] Parâmetros de leitura do balancete — técnicos, sem dado de cliente.
SCI_PYTHON=python3
SCI_BAL_CTA_INI=
SCI_BAL_CTA_FIN=
SCI_BAL_CODTPCC=
SCI_BAL_DATE_STYLE=
SCI_BAL_CONTABILIZACAO=
SCI_BAL_CONSOLIDADA=
SCI_BAL_TODAS_CONTAS=
SCI_BAL_NIVEIS=

# ── Certificados digitais ───────────────────────────────────────────────────
# [NOVO] CERTIFICADO_KEK cifra os PFX no banco. Chave diferente por instalação:
# com a mesma, um dump de um banco abriria os certificados do outro.
CERTIFICADO_KEK=
CERTIFICADO_SENHA=
CERTIFICADO_PF_SENHA=

# ── SERPRO (integra contador) ───────────────────────────────────────────────
# [NOVO] O contrato é por CNPJ contratante — o do cliente desta instalação.
CONSUMER_KEY=
CONSUMER_SECRET=
CNPJ_CONTRATANTE=

# ── Acessórias ──────────────────────────────────────────────────────────────
# [NOVO] Token por conta. O token do outro cliente traria a carteira dele.
ACESSORIAS_API_URL=
ACESSORIAS_API_TOKEN=
ACESSORIAS_USER=

# ── Google Drive ────────────────────────────────────────────────────────────
# [DECIDIR] Conta de serviço/OAuth próprios se o cliente usar o sync.
GOOGLE_DRIVE_OAUTH_CREDENTIALS_FILE=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_SYNC_ENABLED=false
GOOGLE_DRIVE_SYNC_CRON=
GOOGLE_DRIVE_SA_JSON_FILE=
GOOGLE_DRIVE_SA_JSON=

# ── Gov.br / SERPRO ID / Google Calendar ────────────────────────────────────
# [COPIAR] as credenciais; [NOVO] as três REDIRECT_URI — e cada uma precisa ser
# cadastrada no respectivo provedor antes de funcionar.
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_REDIRECT_URI=https://oneclick.wpsis.com.br/api/govbr/callback
GOVBR_BASE_URL_SSO=
GOVBR_BASE_URL_ASSINATURA=
SERPROID_CLIENT_ID=
SERPROID_CLIENT_SECRET=
SERPROID_REDIRECT_URI=https://oneclick.wpsis.com.br/api/serproid/callback
SERPROID_BASE_URL=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://oneclick.wpsis.com.br/api/google-calendar/callback

# ── Distribuição de notas (cron) ────────────────────────────────────────────
# [COPIAR] os parâmetros. Deixe DESLIGADO na subida e ligue depois de conferir
# o certificado: ligado, o cron começa a baixar NFe em produção no primeiro
# boot, antes de alguém revisar a instalação.
NFE_DIST_ENABLED=false
NFE_DIST_AMBIENTE=
NFE_DIST_CRON=
NFSE_DIST_ENABLED=false
NFSE_DIST_CRON=
NFSE_ADN_BASE_URL=

# ── SITFIS / captcha ────────────────────────────────────────────────────────
# [COPIAR] IDs de serviço; [DECIDIR] a chave do 2captcha (é consumo pago —
# duas instalações gastam do mesmo saldo).
SITFIS_ID_SERVICO_SOLICITAR=
SITFIS_ID_SERVICO_EMITIR=
CAPTCHA_2CAPTCHA_API_KEY=
CAPTCHA_PROVIDER=

# ── Ponte do Service Manager ────────────────────────────────────────────────
# [NOVO] Segredo do daemon. Com o mesmo das duas, um Service Manager poderia
# atender pedidos da instalação errada.
LAUNCHER_DAEMON_SECRET=

# ── Backups ─────────────────────────────────────────────────────────────────
# [NOVO] Precisa bater com os volumes do docker-compose.yml desta stack.
ONECLICK_BACKUPS_DIR=/var/backups/oneclick-wpsis
ONECLICK_SYSTEM_BACKUPS_DIR=/var/backups/oneclick-wpsis-system

# ── Diversos ────────────────────────────────────────────────────────────────
CAIXA_POSTAL_LOTE_DELAY_MS=
# [DECIDIR] Chave da Anthropic — consumo pago, compartilhado se repetir.
ANTHROPIC_API_KEY=
AGENT_REPO_PATH=/repo-src
# [DECIDIR] Integração com a webapp fiscal. Vazio enquanto a stack não estiver
# na rede fiscal_net (ver docker-compose.yml).
WEBAPP_API_URL=
